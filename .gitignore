# Gradle / JVM
.gradle/
build/
*.class
*.jar
# After *.jar, not before it: the last matching pattern wins, so with the
# negation first the wrapper jar stayed ignored and CI checked out a tree whose
# ./gradlew could not start.
!gradle/wrapper/gradle-wrapper.jar
*.log
hs_err_pid*

# IDE
.idea/
*.iml
.vscode/

# Local config and secrets
.env
.env.*
local.properties
*.local.conf

# Runtime data
data/
# Printed papers plus corpus/digest (every run). Never commit this —
# corpus.json is other people's posts and must not go online via git.
editions/
# Ignore every dist/ by default (the print skill has used one that held
# corpus.json). Un-ignore only the repo-root public shelf so a checkout
# knows what is staged for Vercel. Still deploy with
# `npx vercel deploy dist`, never as a git-linked project.
dist/
!/dist/
!/dist/**
# .vercel/ under dist/ stays ignored by the pattern below.
.vercel/
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store
